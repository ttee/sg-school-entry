# Database
# For local development: SQLite (uncomment line below and comment out Postgres lines)
# DATABASE_URL="file:./dev.db"

# For production: PostgreSQL connection string
DATABASE_URL="postgresql://user:password@host:5432/database?pgbouncer=true"

# Optional: Direct connection URL for migrations (required for Supabase/pooled connections)
# Use the direct connection string (port 5432, no pgbouncer) for migrations
# If not set, DATABASE_URL will be used for both queries and migrations
DIRECT_URL="postgresql://user:password@host:5432/database"

# Auth.js secret
# Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Next.js
NEXTAUTH_URL="http://localhost:3000"

# Google Gemini API (free tier available)
# Get your free key at: https://aistudio.google.com/apikey
# Required for AI-powered speaking evaluation and writing feedback
# Note: Free-tier audio may be used by Google to improve products
GEMINI_API_KEY=""
# Alternative name (either works):
# GOOGLE_GENERATIVE_AI_API_KEY=""

# Optional: Override Gemini model (defaults to gemini-2.5-flash with automatic fallback)
# GEMINI_MODEL="gemini-2.5-flash"

# Public contact information (displayed on landing page)
# Studio contact email (defaults to pangtee@gmail.com if not set)
NEXT_PUBLIC_CONTACT_EMAIL="pangtee@gmail.com"

# Optional: Studio WeChat ID (shows "报名时向老师索取微信号" placeholder if not set)
# NEXT_PUBLIC_WECHAT_ID=""

# PayNow number (defaults to 94594601 if not set)
NEXT_PUBLIC_PAYNOW="94594601"
