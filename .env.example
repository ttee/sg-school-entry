# Database
# For local development: SQLite (uncomment line below and comment out Postgres lines)
# DATABASE_URL="file:./dev.db"

# For production: PostgreSQL connection string
DATABASE_URL="postgresql://user:password@host:5432/database?pgbouncer=true"

# Optional: Direct connection URL for migrations (required for Supabase/pooled connections)
# Use the direct connection string (port 5432, no pgbouncer) for migrations
# If not set, DATABASE_URL will be used for both queries and migrations
DIRECT_URL="postgresql://user:password@host:5432/database"

# Auth.js secret
# Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Next.js
NEXTAUTH_URL="http://localhost:3000"
