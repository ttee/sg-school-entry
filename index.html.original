    const htmlEl = document.documentElement;
    const metaDesc = document.querySelector('meta[name="description"]');
    const ogTitle = document.querySelector('meta[property="og:title"]');
    const ogDesc = document.querySelector('meta[property="og:description"]');
    const ogLocale = document.querySelector('meta[property="og:locale"]');
    const btnZh = document.getElementById("btn-zh");
    const btnEn = document.getElementById("btn-en");
    const yearSel = document.getElementById("year");

    function fillYears(lang) {
      const keep = yearSel.value;
      const dict = COPY[lang];
      yearSel.innerHTML = "";
      const first = document.createElement("option");
      first.value = "";
      first.textContent = dict.yearAny;
      yearSel.appendChild(first);
      for (let y = 2019; y >= 2008; y--) {
        const o = document.createElement("option");
        o.value = String(y);
        o.textContent = String(y);
        yearSel.appendChild(o);
      }
      if (keep && yearSel.querySelector('[value="' + keep + '"]')) yearSel.value = keep;
    }

    function applyLang(lang) {
      const dict = COPY[lang] || COPY["zh-CN"];
      htmlEl.lang = lang === "en" ? "en" : "zh-CN";
      document.title = dict.title;
      if (metaDesc) metaDesc.setAttribute("content", dict.desc);
      if (ogTitle) ogTitle.setAttribute("content", dict.title);
      if (ogDesc) ogDesc.setAttribute("content", dict.desc);
      if (ogLocale) ogLocale.setAttribute("content", lang === "en" ? "en_SG" : "zh_CN");
      document.querySelectorAll("[data-i18n]").forEach((el) => {
        const key = el.getAttribute("data-i18n");
        if (dict[key] != null) el.textContent = dict[key];
      });
      document.querySelectorAll("[data-i18n-placeholder]").forEach((el) => {
        const key = el.getAttribute("data-i18n-placeholder");
        if (dict[key] != null) el.setAttribute("placeholder", dict[key]);
      });
      btnZh.setAttribute("aria-pressed", lang !== "en" ? "true" : "false");
      btnEn.setAttribute("aria-pressed", lang === "en" ? "true" : "false");
      fillYears(lang);
      try { localStorage.setItem("sgse-lang", lang); } catch (e) {}
    }

    btnZh.addEventListener("click", () => applyLang("zh-CN"));
    btnEn.addEventListener("click", () => applyLang("en"));

    let start = "zh-CN";
    try {
      const saved = localStorage.getItem("sgse-lang");
      if (saved === "en" || saved === "zh-CN") start = saved;
    } catch (e) {}
    applyLang(start);

    const form = document.getElementById("consult-form");
    const thanks = document.getElementById("thanks");
    form.addEventListener("submit", (e) => {
      e.preventDefault();
      if (!form.reportValidity()) return;
      form.hidden = true;
      thanks.classList.add("show");
    });

    document.querySelectorAll('[data-ceq-track]').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const track = e.currentTarget.getAttribute('data-ceq-track');
        if (track) {
          setTimeout(() => {
            const trackSelect = form.querySelector('[name="track"]');
            if (trackSelect) trackSelect.value = track;
          }, 100);
        }
      });
    });
  </script>
</body>
</html>
