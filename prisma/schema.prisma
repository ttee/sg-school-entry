generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // directUrl is optional - only needed for pooled connections (e.g., Supabase pgbouncer)
  // If your DATABASE_URL uses connection pooling, set DIRECT_URL to the direct connection
  // Otherwise, migrations will use DATABASE_URL directly
}

model User {
  id          String       @id @default(uuid())
  email       String       @unique
  password    String
  name        String?
  role        String       @default("student")
  level       String?
  subscribed  Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  submissions Submission[]
}

model Week {
  id          String       @id @default(uuid())
  level       String
  weekNumber  Int
  title       String
  description String?
  isSample    Boolean      @default(false)
  dueDate     DateTime?
  errorFocus  String?
  parentBrief String?
  videoUrl    String?
  kaizenFocus String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  questions   Question[]
  submissions Submission[]

  @@unique([level, weekNumber])
}

model Question {
  id            String   @id @default(uuid())
  weekId        String
  type          String
  order         Int
  content       String
  options       String?
  correctAnswer String?
  points        Int      @default(1)
  audioUrl      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  week          Week     @relation(fields: [weekId], references: [id], onDelete: Cascade)

  @@unique([weekId, order])
  @@index([weekId])
}

model Submission {
  id          String    @id @default(uuid())
  userId      String
  weekId      String
  answers     String
  score       Int?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  week        Week      @relation(fields: [weekId], references: [id], onDelete: Cascade)

  @@unique([userId, weekId])
  @@index([userId])
  @@index([weekId])
}

model SpeakingAttempt {
  id            String   @id @default(uuid())
  userId        String
  questionId    String
  attemptNumber Int
  durationSec   Int
  transcript    String
  scores        String
  feedback      String
  audioUrl      String?
  createdAt     DateTime @default(now())

  @@index([userId, questionId])
  @@index([userId, createdAt])
}

model WritingFeedback {
  id         String   @id @default(uuid())
  userId     String
  questionId String
  text       String
  feedback   String
  createdAt  DateTime @default(now())

  @@index([userId, questionId])
}
